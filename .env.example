# --- Venue API credentials (fill in what you have; adapters self-disable if blank) ---
TICKETMASTER_API_KEY=          # https://developer.ticketmaster.com  (instant free key)
SEATGEEK_CLIENT_ID=            # https://seatgeek.com/account/develop
SEATGEEK_CLIENT_SECRET=
STUBHUB_APP_TOKEN=             # partner program (phase 2)

# --- Push notifications ---
# Default provider is ntfy (free). Pick a hard-to-guess topic and subscribe in the app.
NOTIFY_PROVIDER=ntfy           # ntfy | pushover
NTFY_TOPIC=rush-sentry-CHANGE-ME
NTFY_SERVER=https://ntfy.sh
# Pushover (if NOTIFY_PROVIDER=pushover)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- Purchase behavior ---
# notify (default) | assist | auto
PURCHASE_MODE=notify
# auto mode is a no-op unless this is exactly 1 — see docs/LEGAL.md
I_UNDERSTAND_THE_RISKS=0

# --- Runtime ---
WATCH_FILE=config/watch.json
USE_MOCK=1                     # 1 = emit a fake listing so you can test end-to-end
